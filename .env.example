# Django Settings
SECRET_KEY=django-insecure-replace-this-with-a-real-key
DEBUG=False

# ALLOWED_HOSTS - solo el dominio, sin https:// ni /
# DEV: ALLOWED_HOSTS=jardinesdev.gobiernoriocuarto.gob.ar
# PRO: ALLOWED_HOSTS=jardines.gobiernoriocuarto.gob.ar
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF_TRUSTED_ORIGINS - URL completa con https://
# DEV: CSRF_TRUSTED_ORIGINS=https://jardinesdev.gobiernoriocuarto.gob.ar
# PRO: CSRF_TRUSTED_ORIGINS=https://jardines.gobiernoriocuarto.gob.ar
CSRF_TRUSTED_ORIGINS=

# Database Configuration
# format: postgres://user:password@host:port/dbname
# format: mysql://user:password@host:port/dbname
# format: sqlite:///db.sqlite3
DATABASE_URL=mysql://user:password@db:3306/sistema_jardines
DB_NAME=sistema_jardines
DB_USER=user
DB_PASSWORD=password
DB_HOST=db
DB_PORT=3306

# MySQL Image Configuration
MYSQL_DATABASE=sistema_jardines
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=root_password

# Security Settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Static Files
# STATIC_ROOT is set in settings.py as BaseDir / 'staticfiles'
